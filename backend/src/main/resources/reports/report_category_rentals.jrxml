                    <textElement verticalAlignment="Middle">
                        <font fontName="SansSerif" size="11" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["CATEGORÍA: " + ($F{category_name} != null ? $F{category_name}.toUpperCase() : "GENERAL")]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
