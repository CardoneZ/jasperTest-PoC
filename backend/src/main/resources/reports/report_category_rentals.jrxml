              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="report_category_rentals" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8b76a661-0d9f-4e4c-cde3-2c2e8e1b1c22">

    <parameter name="P_REPORT_TITLE" class="java.lang.String"/>
    <parameter name="P_GENERATION_DATE" class="java.lang.String"/>
    <parameter name="P_CATEGORY_FILTER" class="java.lang.String"/>
    <parameter name="P_MIN_RENTALS_FILTER" class="java.lang.String"/>
    <parameter name="P_USER" class="java.lang.String"/>

    <field name="category_name" class="java.lang.String"/>
    <field name="film_id" class="java.lang.Object"/>
    <field name="title" class="java.lang.String"/>
    <field name="rating" class="java.lang.String"/>
    <field name="rental_rate" class="java.lang.Number"/>
    <field name="rental_count" class="java.lang.Number"/>
    <field name="total_revenue" class="java.lang.Number"/>
    <field name="avg_duration" class="java.lang.Number"/>

    <!-- Variables for Group Subtotals -->
    <variable name="GRP_FILM_COUNT" class="java.lang.Integer" resetType="Group" resetGroup="CategoryGroup" calculation="Count">
        <variableExpression><![CDATA[$F{film_id}]]></variableExpression>
    </variable>
    <variable name="GRP_RENTAL_COUNT" class="java.lang.Long" resetType="Group" resetGroup="CategoryGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{rental_count} != null ? Long.valueOf($F{rental_count}.toString()) : 0L]]></variableExpression>
    </variable>
    <variable name="GRP_REVENUE" class="java.lang.Double" resetType="Group" resetGroup="CategoryGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{total_revenue} != null ? Double.valueOf($F{total_revenue}.toString()) : 0.0]]></variableExpression>
    </variable>

    <!-- Variables for Grand Totals -->
    <variable name="TOTAL_FILMS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{film_id}]]></variableExpression>
    </variable>
    <variable name="TOTAL_RENTAL_COUNT" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{rental_count} != null ? Long.valueOf($F{rental_count}.toString()) : 0L]]></variableExpression>
    </variable>
    <variable name="TOTAL_REVENUE" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{total_revenue} != null ? Double.valueOf($F{total_revenue}.toString()) : 0.0]]></variableExpression>
    </variable>

    <group name="CategoryGroup" isReprintHeaderOnEachPage="false">
